#version 450

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_q2_0 data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

void main() {
    const uint tid = gl_LocalInvocationID.x;
    // 8 threads per 64-value block, 8 values (2 bytes) per thread
    const uint ib = gl_WorkGroupID.x * 32 + tid / 8;
    if (ib >= p.nel / 64) {
        return;
    }

    const uint iqs = (tid % 8) * 2;
    const uint b_idx = ib * 64 + iqs * 4;

    const float d = float(data_a[ib].d);
    const uint q0 = uint(data_a[ib].qs[iqs]);
    const uint q1 = uint(data_a[ib].qs[iqs + 1]);

    // 2-bit codes {0,1,2,3} map to {-1,0,+1,+2}
    data_b[b_idx + 0] = D_TYPE(d * (int( q0        & 3u) - 1));
    data_b[b_idx + 1] = D_TYPE(d * (int((q0 >> 2u) & 3u) - 1));
    data_b[b_idx + 2] = D_TYPE(d * (int((q0 >> 4u) & 3u) - 1));
    data_b[b_idx + 3] = D_TYPE(d * (int( q0 >> 6u      ) - 1));
    data_b[b_idx + 4] = D_TYPE(d * (int( q1        & 3u) - 1));
    data_b[b_idx + 5] = D_TYPE(d * (int((q1 >> 2u) & 3u) - 1));
    data_b[b_idx + 6] = D_TYPE(d * (int((q1 >> 4u) & 3u) - 1));
    data_b[b_idx + 7] = D_TYPE(d * (int( q1 >> 6u      ) - 1));
}
